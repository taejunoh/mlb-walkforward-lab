{
  "$defs": {
    "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  },
  "$id": "r4_privileged_materialization_admission_locator_v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "admission_record_sha256": {"$ref": "#/$defs/sha256"},
    "attempt_uuid": {"pattern": "^[0-9a-f]{32}$", "type": "string"},
    "authority_id": {"const": "r4-disjoint-custody-v2-execution-v1"},
    "kind": {"const": "R4_PRIVILEGED_MATERIALIZATION_ADMISSION_LOCATOR_V2"},
    "namespace": {"const": "org.mlb-walkforward.r4.protected-execution-authority/v1"},
    "registry_relative_path": {
      "pattern": "^control/admissions/[0-9a-f]{32}\\.json$",
      "type": "string"
    },
    "locator_sha256": {"$ref": "#/$defs/sha256"},
    "sha256": {"$ref": "#/$defs/sha256"}
  },
  "required": [
    "admission_record_sha256", "attempt_uuid", "authority_id", "kind", "namespace",
    "registry_relative_path", "locator_sha256", "sha256"
  ],
  "type": "object"
}
