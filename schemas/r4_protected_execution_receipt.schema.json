    "interpreter_post_install_codesign_identity_sha256": {"$ref": "#/$defs/sha256"},
    "sha256": {
      "$ref": "#/$defs/sha256"
    },
    "state": {
      "const": "SEALED"
    },
    "task14_approval_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "wheel_set_sha256": {
      "$ref": "#/$defs/sha256"
    }
