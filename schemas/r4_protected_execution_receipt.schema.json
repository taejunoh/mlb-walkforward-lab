      "$ref": "#/$defs/sha256"
    },
    "public_key_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "published_closure_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "required_blob_set_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "runtime_manifest_sha256": {
      "$ref": "#/$defs/sha256"
