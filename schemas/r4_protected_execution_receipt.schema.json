    "public_key_sha256",
    "published_closure_sha256",
    "sandbox_launcher_path",
    "sandbox_launcher_descriptor_identity_sha256",
    "sandbox_launcher_sha256",
    "sandbox_launcher_codesign_identity_sha256",
    "sandbox_profile_template_sha256",
    "sandbox_profile_sha256",
    "child_command_template_sha256",
    "installer_command_sha256",
    "import_command_sha256",
    "interpreter_pre_install_sha256",
    "interpreter_pre_install_mach_o_sha256",
    "interpreter_pre_install_codesign_identity_sha256",
    "interpreter_post_install_sha256",
    "interpreter_post_install_mach_o_sha256",
    "interpreter_post_install_codesign_identity_sha256",
    "environment_sha256",
    "sha256"
