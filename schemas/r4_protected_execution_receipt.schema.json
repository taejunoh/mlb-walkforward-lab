    "runtime_output_closure_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "sandbox_profile_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "sandbox_launcher_path": {"const": "/usr/bin/sandbox-exec"},
