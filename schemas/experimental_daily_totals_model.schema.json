{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experimental_daily_totals_model.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "content_sha256", "status_labels", "source_report_relative", "source_report_sha256", "target_date", "cutoff_date", "history_source", "live_source", "windows", "candidate_ids", "candidate_definition_sha256", "development_metrics", "selected_candidate", "final_metrics", "development_residual_samples", "development_residual_sha256", "development_residual_count"],
  "properties": {
    "schema": {"const": "PROVISIONAL_DAILY_TOTALS_MODEL_V1"},
    "content_sha256": {"$ref": "#/$defs/sha"}, "status_labels": {"const": ["RESEARCH ONLY", "ONE-SEASON PROVISIONAL", "NOT BET-VALIDATED"]},
    "source_report_relative": {"$ref": "#/$defs/path"}, "source_report_sha256": {"$ref": "#/$defs/sha"},
    "target_date": {"format": "date"}, "cutoff_date": {"format": "date"},
    "history_source": {"$ref": "#/$defs/historySource"}, "live_source": {"$ref": "#/$defs/liveSource"},
    "windows": {"$ref": "#/$defs/windows"}, "candidate_ids": {"const": ["LEAGUE_30", "TEAM_30", "TEAM_VENUE_30"]}, "candidate_definition_sha256": {"$ref": "#/$defs/sha"},
    "development_metrics": {"type": "object", "additionalProperties": false, "required": ["LEAGUE_30", "TEAM_30", "TEAM_VENUE_30"], "properties": {"LEAGUE_30": {"$ref": "#/$defs/metrics"}, "TEAM_30": {"$ref": "#/$defs/metrics"}, "TEAM_VENUE_30": {"$ref": "#/$defs/metrics"}}},
    "selected_candidate": {"enum": ["LEAGUE_30", "TEAM_30", "TEAM_VENUE_30"]}, "final_metrics": {"$ref": "#/$defs/metrics"},
    "development_residual_samples": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}, "development_residual_sha256": {"$ref": "#/$defs/sha"}, "development_residual_count": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.?(/|$)).+"},
    "source": {"type": "object", "additionalProperties": false, "required": ["binding_role", "binding_sha256", "query_identity_sha256", "claim_relative", "claim_sha256", "receipt_relative", "receipt_sha256", "receipt_sidecar_relative", "receipt_sidecar_sha256", "completion_relative", "completion_sha256", "completion_sidecar_relative", "completion_sidecar_sha256", "manifest_relative", "manifest_sha256", "manifest_sidecar_relative", "manifest_sidecar_sha256", "payload_relative", "payload_sha256", "byte_length"], "properties": {"binding_role": {"type": "string"}, "binding_sha256": {"$ref": "#/$defs/sha"}, "query_identity_sha256": {"$ref": "#/$defs/sha"}, "claim_relative": {"$ref": "#/$defs/path"}, "claim_sha256": {"$ref": "#/$defs/sha"}, "receipt_relative": {"$ref": "#/$defs/path"}, "receipt_sha256": {"$ref": "#/$defs/sha"}, "receipt_sidecar_relative": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]}, "receipt_sidecar_sha256": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]}, "completion_relative": {"$ref": "#/$defs/path"}, "completion_sha256": {"$ref": "#/$defs/sha"}, "completion_sidecar_relative": {"$ref": "#/$defs/path"}, "completion_sidecar_sha256": {"$ref": "#/$defs/sha"}, "manifest_relative": {"$ref": "#/$defs/path"}, "manifest_sha256": {"$ref": "#/$defs/sha"}, "manifest_sidecar_relative": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]}, "manifest_sidecar_sha256": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]}, "payload_relative": {"$ref": "#/$defs/path"}, "payload_sha256": {"$ref": "#/$defs/sha"}, "byte_length": {"type": "integer", "minimum": 0}}},
    "historySource": {"allOf": [{"$ref": "#/$defs/source"}, {"properties": {"binding_role": {"const": "HISTORY_SCHEDULE"}, "receipt_sidecar_relative": {"$ref": "#/$defs/path"}, "receipt_sidecar_sha256": {"$ref": "#/$defs/sha"}}}]},
    "liveSource": {"allOf": [{"$ref": "#/$defs/source"}, {"properties": {"binding_role": {"const": "LIVE_SCHEDULE"}, "receipt_sidecar_relative": {"type": "null"}, "receipt_sidecar_sha256": {"type": "null"}}}]},
    "windows": {"type": "object", "additionalProperties": false, "required": ["development_start", "development_end", "final_start", "final_end", "league_days", "venue_days", "team_shrinkage_games", "venue_shrinkage_games"], "properties": {"development_start": {"format": "date"}, "development_end": {"format": "date"}, "final_start": {"format": "date"}, "final_end": {"format": "date"}, "league_days": {"const": 30}, "venue_days": {"const": 60}, "team_shrinkage_games": {"const": 10}, "venue_shrinkage_games": {"const": 20}}},
    "metrics": {"type": "object", "additionalProperties": false, "required": ["games", "mae", "rmse", "poisson_deviance", "interval_80_coverage"], "properties": {"games": {"type": "integer", "minimum": 100}, "mae": {"type": "number", "minimum": 0}, "rmse": {"type": "number", "minimum": 0}, "poisson_deviance": {"type": "number", "minimum": 0}, "interval_80_coverage": {"type": "number", "minimum": 0, "maximum": 1}}}
  }
}
