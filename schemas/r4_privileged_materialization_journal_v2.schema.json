        "sequence": {"const": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "stage_name": {"$ref": "#/$defs/attempt_uuid"}
      },
      "required": ["admission_record_sha256", "attempt_uuid", "authority_id", "kind", "namespace", "phase", "sequence", "stage_name", "journal_sha256", "sha256"],
      "type": "object"
    },
    {
