{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v5.2 immutable normalized source snapshot candidate",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "positiveId": {"type": "integer", "minimum": 1},
    "nullableNonnegative": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
    "game": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actual_starter_ids": {"type": "array", "items": {"$ref": "#/$defs/positiveId"}, "uniqueItems": true},
        "alternate_site": {"type": "boolean"},
        "away_score": {"$ref": "#/$defs/nullableNonnegative"},
        "away_starting_hitter_ids": {"type": "array", "items": {"$ref": "#/$defs/positiveId"}, "uniqueItems": true},
        "away_team_id": {"$ref": "#/$defs/positiveId"},
        "boxscore_query_sidecar_sha256": {"$ref": "#/$defs/sha256"},
        "completed_innings": {"$ref": "#/$defs/nullableNonnegative"},
        "doubleheader_order": {"type": "integer", "minimum": 1},
        "feature_history_cutoff": {"$ref": "#/$defs/date"},
        "game_pk": {"$ref": "#/$defs/positiveId"},
        "home_score": {"$ref": "#/$defs/nullableNonnegative"},
        "home_starting_hitter_ids": {"type": "array", "items": {"$ref": "#/$defs/positiveId"}, "uniqueItems": true},
        "home_team_id": {"$ref": "#/$defs/positiveId"},
        "neutral_site": {"type": "boolean"},
        "official_date": {"$ref": "#/$defs/date"},
        "participant_provenance": {"enum": ["RECONSTRUCTED_FINAL_PARTICIPANTS", "HISTORICAL_NO_PARTICIPANTS"]},
        "played": {"type": "boolean"},
        "schedule_query_sidecar_sha256": {"$ref": "#/$defs/sha256"},
        "scheduled_innings": {"$ref": "#/$defs/nullableNonnegative"},
        "scheduled_start_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "season": {"type": "integer", "minimum": 2018, "maximum": 2024},
        "season_start_date": {"$ref": "#/$defs/date"},
        "source_game_sha256": {"$ref": "#/$defs/sha256"},
        "terminal_status": {"type": "string", "minLength": 1},
        "venue_id": {"$ref": "#/$defs/positiveId"},
        "verification_status": {"enum": ["VERIFIED", "INELIGIBLE_UNPLAYED"]},
        "winner_team_id": {"oneOf": [{"$ref": "#/$defs/positiveId"}, {"type": "null"}]}
      },
      "required": [
        "actual_starter_ids", "alternate_site", "away_score",
        "away_starting_hitter_ids", "away_team_id", "completed_innings",
        "doubleheader_order", "feature_history_cutoff", "game_pk",
        "home_score", "home_starting_hitter_ids", "home_team_id",
        "neutral_site", "official_date", "participant_provenance", "played",
        "schedule_query_sidecar_sha256", "scheduled_innings",
        "scheduled_start_utc", "season", "season_start_date",
        "source_game_sha256", "terminal_status", "venue_id",
        "verification_status", "winner_team_id"
      ],
      "oneOf": [
        {
          "properties": {
            "actual_starter_ids": {"type": "array", "minItems": 2, "maxItems": 2},
            "away_score": {"type": "integer", "minimum": 0},
            "away_starting_hitter_ids": {"type": "array", "minItems": 9, "maxItems": 9},
            "home_score": {"type": "integer", "minimum": 0},
            "home_starting_hitter_ids": {"type": "array", "minItems": 9, "maxItems": 9},
            "participant_provenance": {"const": "RECONSTRUCTED_FINAL_PARTICIPANTS"},
            "played": {"const": true},
            "verification_status": {"const": "VERIFIED"},
            "winner_team_id": {"$ref": "#/$defs/positiveId"}
          },
          "required": ["boxscore_query_sidecar_sha256"]
        },
        {
          "properties": {
            "actual_starter_ids": {"type": "array", "maxItems": 0},
            "away_score": {"type": "null"},
            "away_starting_hitter_ids": {"type": "array", "maxItems": 0},
            "home_score": {"type": "null"},
            "home_starting_hitter_ids": {"type": "array", "maxItems": 0},
            "participant_provenance": {"const": "HISTORICAL_NO_PARTICIPANTS"},
            "played": {"const": false},
            "verification_status": {"const": "INELIGIBLE_UNPLAYED"},
            "winner_team_id": {"type": "null"}
          },
          "not": {"required": ["boxscore_query_sidecar_sha256"]}
        }
      ]
    },
    "gamePayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "games": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/game"}, "uniqueItems": true},
        "grain": {"const": "season_game_evidence_snapshot"},
        "schema_version": {"const": 1},
        "source_query_sidecar_sha256s": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true
        }
      },
      "required": ["games", "grain", "schema_version", "source_query_sidecar_sha256s"]
    },
    "statcastChild": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inclusive_start": {"$ref": "#/$defs/date"},
        "inclusive_end": {"$ref": "#/$defs/date"},
        "query_sidecar_sha256": {"$ref": "#/$defs/sha256"},
        "split_disposition": {"const": "READY"}
      },
      "required": ["inclusive_start", "inclusive_end", "query_sidecar_sha256", "split_disposition"]
    },
    "statcastPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "grain": {"const": "pitch"},
        "parent_coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inclusive_start": {"$ref": "#/$defs/date"},
            "inclusive_end": {"$ref": "#/$defs/date"}
          },
          "required": ["inclusive_start", "inclusive_end"]
        },
        "children": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/statcastChild"}, "uniqueItems": true},
        "child_query_sidecar_sha256s": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
        "played_game_pks": {"type": "array", "items": {"$ref": "#/$defs/positiveId"}, "uniqueItems": true},
        "statcast_game_pks": {"type": "array", "items": {"$ref": "#/$defs/positiveId"}, "uniqueItems": true},
        "unique_pitch_count": {"type": "integer", "minimum": 0},
        "split_state": {"const": "READY_COMPLETE"}
      },
      "required": ["schema_version", "grain", "parent_coverage", "children", "child_query_sidecar_sha256s", "played_game_pks", "statcast_game_pks", "unique_pitch_count", "split_state"]
    },
    "pitchingRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "as_of_date": {"$ref": "#/$defs/date"},
        "consumer_cutoff_dates": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/date"}
        },
        "consuming_game_pks": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/positiveId"}, "uniqueItems": true
        },
        "earned_runs": {"type": "integer", "minimum": 0},
        "outs": {"type": "integer", "minimum": 0},
        "batters_faced": {"type": "integer", "minimum": 0},
        "disposition": {"const": "PRESEASON_NO_CURRENT_SEASON_PITCHING"},
        "query_sidecar_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["as_of_date", "consumer_cutoff_dates", "consuming_game_pks", "query_sidecar_sha256"],
      "oneOf": [
        {
          "required": ["earned_runs", "outs", "batters_faced"],
          "not": {"required": ["disposition"]}
        },
        {
          "required": ["disposition"],
          "not": {
            "anyOf": [
              {"required": ["earned_runs"]},
              {"required": ["outs"]},
              {"required": ["batters_faced"]}
            ]
          }
        }
      ]
    },
    "pitchingPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "grain": {"const": "season_d1_league_pitching_reference"},
        "records": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/pitchingRecord"}, "uniqueItems": true
        },
        "query_sidecar_sha256s": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true
        }
      },
      "required": ["schema_version", "grain", "records", "query_sidecar_sha256s"]
    },
    "referenceTeam": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "home_venue_id": {"$ref": "#/$defs/positiveId"},
        "location_name": {"type": "string", "minLength": 1},
        "team_id": {"$ref": "#/$defs/positiveId"},
        "team_name": {"type": "string", "minLength": 1}
      },
      "required": ["home_venue_id", "location_name", "team_id", "team_name"]
    },
    "referenceVenue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "city": {"type": "string", "minLength": 1},
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "venue_id": {"$ref": "#/$defs/positiveId"},
        "venue_name": {"type": "string", "minLength": 1}
      },
      "required": ["city", "latitude", "longitude", "venue_id", "venue_name"]
    },
    "referenceTimezoneRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "effective_end": {"$ref": "#/$defs/date"},
        "effective_start": {"$ref": "#/$defs/date"},
        "time_zone": {"type": "string", "minLength": 1},
        "venue_id": {"$ref": "#/$defs/positiveId"}
      },
      "required": ["effective_end", "effective_start", "time_zone", "venue_id"]
    },
    "referenceObservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alternate_site": {"type": "boolean"},
        "neutral_site": {"type": "boolean"},
        "official_date": {"$ref": "#/$defs/date"},
        "time_zone": {"type": "string", "minLength": 1},
        "venue_id": {"$ref": "#/$defs/positiveId"}
      },
      "required": ["alternate_site", "neutral_site", "official_date", "time_zone", "venue_id"]
    },
    "referencePayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grain": {"const": "effective_dated_venue_team_reference"},
        "observed_venue_date_mappings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/referenceObservation"}, "uniqueItems": true},
        "schema_version": {"const": 1},
        "team_payload_sha256s": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
        "teams": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/referenceTeam"}, "uniqueItems": true},
        "timezone_rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/referenceTimezoneRow"}, "uniqueItems": true},
        "venue_payload_sha256s": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
        "venues": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/referenceVenue"}, "uniqueItems": true}
      },
      "required": ["grain", "observed_venue_date_mappings", "schema_version", "team_payload_sha256s", "teams", "timezone_rows", "venue_payload_sha256s", "venues"]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "run_id": {"type": "string", "minLength": 1},
        "season": {"type": "integer", "minimum": 2018, "maximum": 2024},
        "source": {"const": "mlb_schedule_game_feed"},
        "grain": {"const": "season_game_evidence_snapshot"},
        "status": {"const": "READY"},
        "logical_query_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
        "source_query_sidecar_sha256s": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
        "split_receipt_sha256s": {"type": "array", "maxItems": 0, "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
        "payload": {"$ref": "#/$defs/gamePayload"}
      },
      "required": ["schema_version", "run_id", "season", "source", "grain", "status", "logical_query_ids", "source_query_sidecar_sha256s", "split_receipt_sha256s", "payload"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "run_id": {"type": "string", "minLength": 1},
        "season": {"type": "integer", "minimum": 2018, "maximum": 2024},
        "source": {"const": "baseball_savant_statcast"},
        "grain": {"const": "pitch"},
        "status": {"const": "READY"},
        "logical_query_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
        "source_query_sidecar_sha256s": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
        "split_receipt_sha256s": {"type": "array", "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
        "payload": {"$ref": "#/$defs/statcastPayload"}
      },
      "required": ["schema_version", "run_id", "season", "source", "grain", "status", "logical_query_ids", "source_query_sidecar_sha256s", "split_receipt_sha256s", "payload"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "run_id": {"type": "string", "minLength": 1},
        "season": {"type": "integer", "minimum": 2018, "maximum": 2024},
        "source": {"const": "mlb_stats_pitching"},
        "grain": {"const": "season_d1_league_pitching_reference"},
        "status": {"const": "READY"},
        "logical_query_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
        "source_query_sidecar_sha256s": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
        "split_receipt_sha256s": {"type": "array", "maxItems": 0, "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
        "payload": {"$ref": "#/$defs/pitchingPayload"}
      },
      "required": ["schema_version", "run_id", "season", "source", "grain", "status", "logical_query_ids", "source_query_sidecar_sha256s", "split_receipt_sha256s", "payload"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "run_id": {"type": "string", "minLength": 1},
        "season": {"type": "integer", "minimum": 2018, "maximum": 2024},
        "source": {"const": "venue_team_timezone_table"},
        "grain": {"const": "effective_dated_venue_team_reference"},
        "status": {"const": "READY"},
        "logical_query_ids": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
        "source_query_sidecar_sha256s": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
        "split_receipt_sha256s": {"type": "array", "maxItems": 0, "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
        "payload": {"$ref": "#/$defs/referencePayload"}
      },
      "required": ["schema_version", "run_id", "season", "source", "grain", "status", "logical_query_ids", "source_query_sidecar_sha256s", "split_receipt_sha256s", "payload"]
    }
  ]
}
