      "type": "object",
      "additionalProperties": false,
      "properties": {
        "games": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/historyGame"}, "uniqueItems": true},
        "grain": {"const": "verified_game_projection"},
