    "careerRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseline_batters_faced": {"type": "integer", "minimum": 0},
        "baseline_inclusive_end_date": {"enum": ["2017-12-31", "2021-12-31"]},
        "baseline_query_sidecar_sha256": {"$ref": "#/$defs/sha256"},
        "consumer_cutoff_date": {"$ref": "#/$defs/date"},
        "game_pk": {"$ref": "#/$defs/positiveId"},
        "pitcher_id": {"$ref": "#/$defs/positiveId"},
        "statcast_ready_leaf_sidecar_sha256s": {
          "type": "array", "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true
