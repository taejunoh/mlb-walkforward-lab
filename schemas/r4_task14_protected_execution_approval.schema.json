{
  "$defs": {
    "git": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "helper": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "enum": [
            "bootstrap/provisioner",
            "bootstrap/provisioner.codesign-requirement.txt"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "r4_task14_protected_execution_approval.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_id": {
      "const": "r4-disjoint-custody-v2-execution-v1"
    },
    "exact_suite_log_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "review_package_sha256": {"$ref": "#/$defs/sha256"},
    "observation_authorization_sha256": {"$ref": "#/$defs/sha256"},
    "task14_approval_verification_public_key_sha256": {"const": "c22f28c189032c60329c3299b98a4623153d3c73449548f6cc62e5f9242ecfb1"},
    "helper_hashes": {
      "items": {
        "$ref": "#/$defs/helper"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array",
      "uniqueItems": true,
      "x-r4-semanticConstraints": [
        "lexicographic-path-order",
        "exact-bootstrap-helper-coverage",
        "matches-provisioner-fields"
      ]
    },
    "helper_signing_identity_sha1": {
      "const": "4C6503D0A78A9F51C86CC7C9683115E74A4902A7"
    },
    "helper_team_id": {
      "const": "3BMF4LM6TM"
    },
    "input_bundle_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "kind": {
      "const": "R4_TASK14_PRIVILEGED_MATERIALIZATION_APPROVAL_V2"
    },
    "lock_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "materialization_policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "sandbox_launcher_path": {"const": "/usr/bin/sandbox-exec"},
    "sandbox_launcher_descriptor_identity_sha256": {"$ref": "#/$defs/sha256"},
    "sandbox_launcher_sha256": {"$ref": "#/$defs/sha256"},
    "sandbox_launcher_codesign_identity_sha256": {"$ref": "#/$defs/sha256"},
    "sandbox_profile_template_sha256": {"$ref": "#/$defs/sha256"},
    "child_command_template_sha256": {"$ref": "#/$defs/sha256"},
    "base_interpreter_path": {"const": "runtime/closure/python311/bin/python3.11"},
    "base_interpreter_sha256": {"$ref": "#/$defs/sha256"},
    "base_interpreter_mach_o_sha256": {"$ref": "#/$defs/sha256"},
    "base_interpreter_codesign_identity_sha256": {"$ref": "#/$defs/sha256"},
    "namespace": {
      "const": "org.mlb-walkforward.r4.protected-execution-authority/v1"
    },
    "provisioner_binary_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "provisioner_designated_requirement_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "provisioner_swift_source_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "python_archive_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "required_blob_set_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "reviewed_head": {
      "$ref": "#/$defs/git"
    },
    "reviewed_tree": {
      "$ref": "#/$defs/git"
    },
    "sha256": {
      "$ref": "#/$defs/sha256"
    },
    "wheel_set_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "required": [
    "kind",
    "namespace",
    "authority_id",
    "reviewed_head",
    "reviewed_tree",
    "required_blob_set_sha256",
    "exact_suite_log_sha256",
    "review_package_sha256",
    "observation_authorization_sha256",
    "task14_approval_verification_public_key_sha256",
    "input_bundle_manifest_sha256",
    "lock_sha256",
    "python_archive_sha256",
    "wheel_set_sha256",
    "materialization_policy_sha256",
    "sandbox_launcher_path",
    "sandbox_launcher_descriptor_identity_sha256",
    "sandbox_launcher_sha256",
    "sandbox_launcher_codesign_identity_sha256",
    "sandbox_profile_template_sha256",
    "child_command_template_sha256",
    "base_interpreter_path",
    "base_interpreter_sha256",
    "base_interpreter_mach_o_sha256",
    "base_interpreter_codesign_identity_sha256",
    "provisioner_swift_source_sha256",
    "provisioner_binary_sha256",
    "provisioner_designated_requirement_sha256",
    "helper_hashes",
    "helper_team_id",
    "helper_signing_identity_sha1",
    "sha256"
  ],
  "type": "object"
}
