{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {"const": "VENUE_TIMEZONE_MAPPING"},
    "schema_version": {"const": 1},
    "timezone_rows": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "effective_end": {"format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "type": "string"},
          "effective_start": {"format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "type": "string"},
          "time_zone": {"minLength": 1, "type": "string"},
          "venue_id": {"minimum": 1, "type": "integer"}
        },
        "required": ["effective_end", "effective_start", "time_zone", "venue_id"],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": ["artifact_kind", "schema_version", "timezone_rows"],
  "type": "object"
}
