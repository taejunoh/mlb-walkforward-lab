{
  "$comment": "Frozen V1 genesis plus exact V2 rotation and terminal revocation records.",
  "$defs": {
    "key_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  },
  "$id": "r4_protected_execution_keyring.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "detached_signature_sha256": {"$ref": "#/$defs/sha256"},
        "generation": {"const": 1},
        "issued_at": {"const": "bootstrap-generation-1"},
        "key_id": {"$ref": "#/$defs/key_id"},
        "kind": {"const": "R4_PROTECTED_EXECUTION_KEYRING_V1"},
        "previous_record_sha256": {"type": "null"},
        "public_key_sha256": {"$ref": "#/$defs/sha256"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["kind", "key_id", "generation", "public_key_sha256", "previous_record_sha256", "issued_at", "detached_signature_sha256", "sha256"],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "authority_id": {"const": "r4-disjoint-custody-v2-execution-v1"},
        "detached_signature_sha256": {"$ref": "#/$defs/sha256"},
        "generation": {"minimum": 2, "type": "integer"},
        "issued_at": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string"},
        "kind": {"const": "R4_PROTECTED_EXECUTION_KEY_ROTATION_V2"},
        "namespace": {"const": "org.mlb-walkforward.r4.protected-execution-authority/v1"},
        "new_public_key_sha256": {"$ref": "#/$defs/sha256"},
        "previous_generation": {"minimum": 1, "type": "integer"},
        "previous_public_key_sha256": {"$ref": "#/$defs/sha256"},
        "previous_record_sha256": {"$ref": "#/$defs/sha256"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["authority_id", "generation", "issued_at", "kind", "namespace", "new_public_key_sha256", "previous_generation", "previous_public_key_sha256", "previous_record_sha256", "detached_signature_sha256", "sha256"],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "authority_id": {"const": "r4-disjoint-custody-v2-execution-v1"},
        "detached_signature_sha256": {"$ref": "#/$defs/sha256"},
        "kind": {"const": "R4_PROTECTED_EXECUTION_REVOCATION_V2"},
        "namespace": {"const": "org.mlb-walkforward.r4.protected-execution-authority/v1"},
        "previous_revocation_sha256": {"type": "null"},
        "reason": {"enum": ["KEY_COMPROMISE", "HELPER_COMPROMISE", "MANIFEST_COMPROMISE", "PLATFORM_ASSUMPTION_INVALID"]},
        "revoked_at": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string"},
        "sequence": {"const": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "signer_generation": {"minimum": 1, "type": "integer"},
        "signer_key_record_sha256": {"$ref": "#/$defs/sha256"},
        "signer_public_key_sha256": {"$ref": "#/$defs/sha256"},
        "state": {"const": "REVOKED"},
        "target_generation": {"minimum": 1, "type": "integer"},
        "target_key_record_sha256": {"$ref": "#/$defs/sha256"},
        "target_public_key_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["authority_id", "detached_signature_sha256", "kind", "namespace", "previous_revocation_sha256", "reason", "revoked_at", "sequence", "sha256", "signer_generation", "signer_key_record_sha256", "signer_public_key_sha256", "state", "target_generation", "target_key_record_sha256", "target_public_key_sha256"],
      "type": "object"
    }
  ]
}
