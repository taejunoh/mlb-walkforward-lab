{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"},
    "decimal": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.[0-9]+$"},
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["away_lineup", "home_lineup", "away_observed_starter_id", "home_observed_starter_id", "away_expected_starter_id", "home_expected_starter_id", "payload_relative", "payload_sha256", "receipt_relative", "receipt_sha256", "durable_at_utc"],
      "properties": {
        "away_lineup": {"type": "array", "uniqueItems": true, "maxItems": 9, "items": {"type": "integer", "minimum": 1}},
        "home_lineup": {"type": "array", "uniqueItems": true, "maxItems": 9, "items": {"type": "integer", "minimum": 1}},
        "away_observed_starter_id": {"type": ["integer", "null"], "minimum": 1},
        "home_observed_starter_id": {"type": ["integer", "null"], "minimum": 1},
        "away_expected_starter_id": {"type": ["integer", "null"], "minimum": 1},
        "home_expected_starter_id": {"type": ["integer", "null"], "minimum": 1},
        "payload_relative": {"type": ["string", "null"], "minLength": 1},
        "payload_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "receipt_relative": {"type": ["string", "null"], "minLength": 1},
        "receipt_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "durable_at_utc": {"anyOf": [{"$ref": "#/$defs/utc"}, {"type": "null"}]}
      }
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "trace_relative", "trace_sha256", "decisions"],
      "properties": {
        "status": {"enum": ["NOT_EVALUATED", "EVALUATED"]},
        "trace_relative": {"type": ["string", "null"], "minLength": 1},
        "trace_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "decisions": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["game_pk", "scheduled_start_utc", "away_team", "home_team", "predicted_side", "pick_probability", "data_completeness", "model_status", "participant_complete", "starter_consistent", "late_scratch", "decision", "reason_codes", "selected_book", "selected_event_id", "selected_price", "opposing_price", "selected_captured_at_utc", "quoted_break_even", "price_margin", "book_coverage", "evaluated_at_utc", "legacy_primary_rank"],
            "properties": {
              "game_pk": {"type": "integer", "minimum": 1},
              "scheduled_start_utc": {"$ref": "#/$defs/utc"},
              "away_team": {"type": "string", "minLength": 1},
              "home_team": {"type": "string", "minLength": 1},
              "predicted_side": {"enum": ["away", "home", null]},
              "pick_probability": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
              "data_completeness": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
              "model_status": {"type": "string", "minLength": 1},
              "participant_complete": {"type": "boolean"},
              "starter_consistent": {"type": "boolean"},
              "late_scratch": {"type": "boolean"},
              "decision": {"type": "string", "minLength": 1},
              "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "selected_book": {"type": ["string", "null"], "minLength": 1},
              "selected_event_id": {"type": ["string", "null"], "minLength": 1},
              "selected_price": {"type": ["integer", "null"]},
              "opposing_price": {"type": ["integer", "null"]},
              "selected_captured_at_utc": {"anyOf": [{"$ref": "#/$defs/utc"}, {"type": "null"}]},
              "quoted_break_even": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
              "price_margin": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
              "book_coverage": {"type": "integer", "minimum": 0},
              "evaluated_at_utc": {"$ref": "#/$defs/utc"},
              "legacy_primary_rank": {"type": ["integer", "null"], "minimum": 1}
            }
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "content_sha256", "observed_at_utc", "target_date", "game_pk", "scheduled_start_utc", "away_team", "home_team", "model_card_sha256", "ml_trace_relative", "ml_trace_sha256", "p_home", "predicted_side", "pick_probability", "data_completeness", "participant", "market", "market_status", "totals_status", "primary_eligible", "reason_codes"],
  "properties": {
    "schema": {"const": "PROSPECTIVE_ML_OBSERVATION_SNAPSHOT_V1"},
    "content_sha256": {"$ref": "#/$defs/sha256"},
    "observed_at_utc": {"$ref": "#/$defs/utc"},
    "target_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "game_pk": {"type": "integer", "minimum": 1},
    "scheduled_start_utc": {"$ref": "#/$defs/utc"},
    "away_team": {"type": "string", "minLength": 1},
    "home_team": {"type": "string", "minLength": 1},
    "model_card_sha256": {"$ref": "#/$defs/sha256"},
    "ml_trace_relative": {"type": "string", "minLength": 1},
    "ml_trace_sha256": {"$ref": "#/$defs/sha256"},
    "p_home": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
    "predicted_side": {"enum": ["away", "home", null]},
    "pick_probability": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
    "data_completeness": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
    "participant": {"$ref": "#/$defs/participant"},
    "market": {"$ref": "#/$defs/market"},
    "market_status": {"enum": ["NOT_EVALUATED", "EVALUATED"]},
    "totals_status": {"const": "NOT_EVALUATED"},
    "primary_eligible": {"type": "boolean"},
    "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
