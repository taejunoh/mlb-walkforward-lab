{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experimental_daily_totals_overlay.schema.json",
  "title": "Provisional daily totals overlay report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "content_sha256", "status_labels", "target_date", "model_report_relative", "model_report_sha256", "model_trace_relative", "model_trace_sha256", "market_snapshot_relative", "market_snapshot_sha256", "policy_schema", "policy_sha256", "evaluated_at_utc", "games"],
  "properties": {
    "schema": {"const": "PROVISIONAL_DAILY_TOTALS_OVERLAY_V1"},
    "content_sha256": {"$ref": "#/$defs/sha"},
    "status_labels": {"const": ["RESEARCH ONLY", "ONE-SEASON PROVISIONAL", "NOT BET-VALIDATED"]},
    "target_date": {"const": "2026-09-01"},
    "model_report_relative": {"$ref": "#/$defs/path"}, "model_report_sha256": {"$ref": "#/$defs/sha"},
    "model_trace_relative": {"$ref": "#/$defs/path"}, "model_trace_sha256": {"$ref": "#/$defs/sha"},
    "market_snapshot_relative": {"$ref": "#/$defs/path"}, "market_snapshot_sha256": {"$ref": "#/$defs/sha"},
    "policy_schema": {"const": "PROVISIONAL_DAILY_TOTALS_OVERLAY_POLICY_V1"}, "policy_sha256": {"$ref": "#/$defs/sha"},
    "evaluated_at_utc": {"$ref": "#/$defs/timestamp"},
    "games": {"type": "array", "minItems": 15, "prefixItems": [{"allOf": [{"oneOf": [{"$ref": "#/$defs/quotedGame"}, {"$ref": "#/$defs/noQuoteGame"}]}, {"type": "object", "properties": {"game_pk": {"const": 822929}}, "required": ["game_pk"]}]}, {"allOf": [{"oneOf": [{"$ref": "#/$defs/quotedGame"}, {"$ref": "#/$defs/noQuoteGame"}]}, {"type": "object", "properties": {"game_pk": {"const": 823340}}, "required": ["game_pk"]}]}, {"allOf": [{"oneOf": [{"$ref": "#/$defs/quotedGame"}, {"$ref": "#/$defs/noQuoteGame"}]}, {"type": "object", "properties": {"game_pk": {"const": 824391}}, "required": ["game_pk"]}]}, {"allOf": [{"oneOf": [{"$ref": "#/$defs/quotedGame"}, {"$ref": "#/$defs/noQuoteGame"}]}, {"type": "object", "properties": {"game_pk": {"const": 824472}}, "required": ["game_pk"]}]}, {"allOf": [{"oneOf": [{"$ref": "#/$defs/quotedGame"}, {"$ref": "#/$defs/noQuoteGame"}]}, {"type": "object", "properties": {"game_pk": {"const": 822687}}, "required": ["game_pk"]}]}, {"allOf": [{"oneOf": [{"$ref": "#/$defs/quotedGame"}, {"$ref": "#/$defs/noQuoteGame"}]}, {"type": "object", "properties": {"game_pk": {"const": 824716}}, "required": ["game_pk"]}]}, {"allOf": [{"oneOf": [{"$ref": "#/$defs/quotedGame"}, {"$ref": "#/$defs/noQuoteGame"}]}, {"type": "object", "properties": {"game_pk": {"const": 823661}}, "required": ["game_pk"]}]}, {"allOf": [{"oneOf": [{"$ref": "#/$defs/quotedGame"}, {"$ref": "#/$defs/noQuoteGame"}]}, {"type": "object", "properties": {"game_pk": {"const": 824070}}, "required": ["game_pk"]}]}, {"allOf": [{"oneOf": [{"$ref": "#/$defs/quotedGame"}, {"$ref": "#/$defs/noQuoteGame"}]}, {"type": "object", "properties": {"game_pk": {"const": 824633}}, "required": ["game_pk"]}]}, {"allOf": [{"oneOf": [{"$ref": "#/$defs/quotedGame"}, {"$ref": "#/$defs/noQuoteGame"}]}, {"type": "object", "properties": {"game_pk": {"const": 822854}}, "required": ["game_pk"]}]}, {"allOf": [{"oneOf": [{"$ref": "#/$defs/quotedGame"}, {"$ref": "#/$defs/noQuoteGame"}]}, {"type": "object", "properties": {"game_pk": {"const": 824148}}, "required": ["game_pk"]}]}, {"allOf": [{"oneOf": [{"$ref": "#/$defs/quotedGame"}, {"$ref": "#/$defs/noQuoteGame"}]}, {"type": "object", "properties": {"game_pk": {"const": 824313}}, "required": ["game_pk"]}]}, {"allOf": [{"oneOf": [{"$ref": "#/$defs/quotedGame"}, {"$ref": "#/$defs/noQuoteGame"}]}, {"type": "object", "properties": {"game_pk": {"const": 823984}}, "required": ["game_pk"]}]}, {"allOf": [{"oneOf": [{"$ref": "#/$defs/quotedGame"}, {"$ref": "#/$defs/noQuoteGame"}]}, {"type": "object", "properties": {"game_pk": {"const": 825038}}, "required": ["game_pk"]}]}, {"allOf": [{"oneOf": [{"$ref": "#/$defs/quotedGame"}, {"$ref": "#/$defs/noQuoteGame"}]}, {"type": "object", "properties": {"game_pk": {"const": 823908}}, "required": ["game_pk"]}]}], "items": false}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.?\\.?(/|$))[^\\\\]+$"},
    "timestamp": {"type": "string", "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.[0-9]{0,5}[1-9])?Z$"},
    "gamePk": {"enum": [822929, 823340, 824391, 824472, 822687, 824716, 823661, 824070, 824633, 822854, 824148, 824313, 823984, 825038, 823908]},
    "price": {"anyOf": [{"type": "integer", "minimum": 100, "maximum": 10000}, {"type": "integer", "minimum": -10000, "maximum": -100}]},
    "support": {"type": "number", "minimum": 0, "maximum": 1},
    "margin": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
    "conditional": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "reasonCodes": {"type": "array", "items": {"enum": ["NO_QUOTE", "GAME_STARTED", "QUOTE_STALE", "RESIDUAL_COUNT_MISMATCH", "NONPUSH_SUPPORT_TOO_LOW", "POINT_GAP_TOO_SMALL", "SUPPORT_MARGIN_TOO_LOW", "AMBIGUOUS_DIRECTION"]}, "uniqueItems": true},
    "quotedGame": {
      "type": "object", "additionalProperties": false,
      "required": ["game_pk", "expected_total", "residual_count", "market_status", "line_half_runs", "over_american_odds", "under_american_odds", "over_support", "under_support", "push_support", "over_conditional_support", "under_conditional_support", "over_support_margin", "under_support_margin", "selected_side", "decision", "reason_codes"],
      "properties": {
        "game_pk": {"$ref": "#/$defs/gamePk"}, "expected_total": {"type": "number", "minimum": 0}, "residual_count": {"type": "integer", "minimum": 0}, "market_status": {"const": "QUOTED"},
        "line_half_runs": {"type": "integer", "minimum": 1}, "over_american_odds": {"$ref": "#/$defs/price"}, "under_american_odds": {"$ref": "#/$defs/price"},
        "over_support": {"$ref": "#/$defs/support"}, "under_support": {"$ref": "#/$defs/support"}, "push_support": {"$ref": "#/$defs/support"},
        "over_conditional_support": {"$ref": "#/$defs/conditional"}, "under_conditional_support": {"$ref": "#/$defs/conditional"},
        "over_support_margin": {"$ref": "#/$defs/margin"}, "under_support_margin": {"$ref": "#/$defs/margin"},
        "selected_side": {"enum": ["OVER", "UNDER", null]}, "decision": {"enum": ["RESEARCH_PICK", "PASS"]}, "reason_codes": {"$ref": "#/$defs/reasonCodes"}
      }
    },
    "noQuoteGame": {
      "type": "object", "additionalProperties": false,
      "required": ["game_pk", "expected_total", "residual_count", "market_status", "decision", "reason_codes"],
      "properties": {"game_pk": {"$ref": "#/$defs/gamePk"}, "expected_total": {"type": "number", "minimum": 0}, "residual_count": {"type": "integer", "minimum": 0}, "market_status": {"const": "NO_QUOTE"}, "decision": {"const": "PASS"}, "reason_codes": {"const": ["NO_QUOTE"]}}
    }
  }
}
