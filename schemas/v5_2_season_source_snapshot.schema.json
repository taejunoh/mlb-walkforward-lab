{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v5.2 closed grain-specific season source snapshot",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "date": {"type": "string", "format": "date"},
    "positiveId": {"type": "integer", "minimum": 1},
    "nullableNonnegative": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
    "gameEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actual_starter_ids": {"type": "array", "items": {"$ref": "#/$defs/positiveId"}, "uniqueItems": true},
        "away_score": {"$ref": "#/$defs/nullableNonnegative"},
        "away_starting_hitter_ids": {"type": "array", "items": {"$ref": "#/$defs/positiveId"}, "uniqueItems": true},
        "away_team_id": {"$ref": "#/$defs/positiveId"},
        "boxscore_query_sidecar_sha256": {"$ref": "#/$defs/sha256"},
        "completed_innings": {"$ref": "#/$defs/nullableNonnegative"},
        "doubleheader_order": {"type": "integer", "minimum": 1},
        "feature_history_cutoff": {"$ref": "#/$defs/date"},
        "game_pk": {"$ref": "#/$defs/positiveId"},
        "home_score": {"$ref": "#/$defs/nullableNonnegative"},
        "home_starting_hitter_ids": {"type": "array", "items": {"$ref": "#/$defs/positiveId"}, "uniqueItems": true},
        "home_team_id": {"$ref": "#/$defs/positiveId"},
        "official_date": {"$ref": "#/$defs/date"},
        "neutral_site": {"type": "boolean"},
        "alternate_site": {"type": "boolean"},
        "participant_provenance": {"enum": ["RECONSTRUCTED_FINAL_PARTICIPANTS", "HISTORICAL_NO_PARTICIPANTS"]},
        "played": {"type": "boolean"},
        "scheduled_innings": {"$ref": "#/$defs/nullableNonnegative"},
        "scheduled_start_utc": {"type": "string", "format": "date-time"},
        "season": {"type": "integer", "minimum": 2018, "maximum": 2024},
        "season_start_date": {"$ref": "#/$defs/date"},
        "source_game_sha256": {"$ref": "#/$defs/sha256"},
        "schedule_query_sidecar_sha256": {"$ref": "#/$defs/sha256"},
        "terminal_status": {"type": "string", "minLength": 1},
        "venue_id": {"$ref": "#/$defs/positiveId"},
        "verification_status": {"enum": ["VERIFIED", "INELIGIBLE_UNPLAYED"]},
        "winner_team_id": {"oneOf": [{"$ref": "#/$defs/positiveId"}, {"type": "null"}]}
      },
      "required": ["alternate_site", "away_team_id", "completed_innings", "doubleheader_order", "feature_history_cutoff", "game_pk", "home_team_id", "neutral_site", "official_date", "participant_provenance", "played", "schedule_query_sidecar_sha256", "scheduled_innings", "scheduled_start_utc", "season", "source_game_sha256", "terminal_status", "venue_id", "verification_status"],
      "oneOf": [
        {
          "properties": {
            "actual_starter_ids": {"type": "array", "items": {"$ref": "#/$defs/positiveId"}, "minItems": 2, "maxItems": 2, "uniqueItems": true},
            "away_score": {"type": "integer", "minimum": 0},
            "away_starting_hitter_ids": {"type": "array", "items": {"$ref": "#/$defs/positiveId"}, "minItems": 9, "maxItems": 9, "uniqueItems": true},
            "home_score": {"type": "integer", "minimum": 0},
            "home_starting_hitter_ids": {"type": "array", "items": {"$ref": "#/$defs/positiveId"}, "minItems": 9, "maxItems": 9, "uniqueItems": true},
            "participant_provenance": {"const": "RECONSTRUCTED_FINAL_PARTICIPANTS"},
            "played": {"const": true},
            "verification_status": {"const": "VERIFIED"},
            "winner_team_id": {"$ref": "#/$defs/positiveId"}
          },
          "required": ["actual_starter_ids", "away_score", "away_starting_hitter_ids", "boxscore_query_sidecar_sha256", "home_score", "home_starting_hitter_ids", "winner_team_id"]
        },
        {
          "properties": {
            "actual_starter_ids": {"type": "array", "maxItems": 0},
            "away_score": {"type": "null"},
            "away_starting_hitter_ids": {"type": "array", "maxItems": 0},
            "home_score": {"type": "null"},
            "home_starting_hitter_ids": {"type": "array", "maxItems": 0},
            "participant_provenance": {"const": "HISTORICAL_NO_PARTICIPANTS"},
            "played": {"const": false},
            "verification_status": {"const": "INELIGIBLE_UNPLAYED"},
            "winner_team_id": {"type": "null"}
          },
          "required": ["actual_starter_ids", "away_score", "away_starting_hitter_ids", "home_score", "home_starting_hitter_ids", "winner_team_id"]
        }
      ]
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "home_venue_id": {"$ref": "#/$defs/positiveId"},
        "location_name": {"type": "string", "minLength": 1},
        "team_id": {"$ref": "#/$defs/positiveId"},
        "team_name": {"type": "string", "minLength": 1}
      },
      "required": ["home_venue_id", "location_name", "team_id", "team_name"]
    },
    "venue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "city": {"type": "string", "minLength": 1},
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "venue_id": {"$ref": "#/$defs/positiveId"},
        "venue_name": {"type": "string", "minLength": 1}
      },
      "required": ["city", "latitude", "longitude", "venue_id", "venue_name"]
    },
    "timezone": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "effective_end": {"$ref": "#/$defs/date"},
        "effective_start": {"$ref": "#/$defs/date"},
        "time_zone": {"type": "string", "minLength": 1},
        "venue_id": {"$ref": "#/$defs/positiveId"}
      },
      "required": ["effective_end", "effective_start", "time_zone", "venue_id"]
    },
    "observedMapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alternate_site": {"type": "boolean"},
        "neutral_site": {"type": "boolean"},
        "official_date": {"$ref": "#/$defs/date"},
        "time_zone": {"type": "string", "minLength": 1},
        "venue_id": {"$ref": "#/$defs/positiveId"}
      },
      "required": ["alternate_site", "neutral_site", "official_date", "time_zone", "venue_id"]
    },
    "historyGame": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "away_team_id": {"$ref": "#/$defs/positiveId"},
        "completed_innings": {"$ref": "#/$defs/nullableNonnegative"},
        "doubleheader_order": {"type": "integer", "minimum": 1},
        "game_pk": {"$ref": "#/$defs/positiveId"},
        "history_cutoff": {"$ref": "#/$defs/date"},
        "home_team_id": {"$ref": "#/$defs/positiveId"},
        "official_date": {"$ref": "#/$defs/date"},
        "projection_sha256": {"$ref": "#/$defs/sha256"},
        "scheduled_innings": {"$ref": "#/$defs/nullableNonnegative"},
        "scheduled_start_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "source_game_sha256": {"$ref": "#/$defs/sha256"},
        "terminal_status": {"type": "string", "minLength": 1},
        "venue_id": {"$ref": "#/$defs/positiveId"}
      },
      "required": ["away_team_id", "completed_innings", "doubleheader_order", "game_pk", "history_cutoff", "home_team_id", "official_date", "projection_sha256", "scheduled_innings", "scheduled_start_utc", "source_game_sha256", "terminal_status", "venue_id"]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "games": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gameEvidence"}},
        "grain": {"const": "season_game_evidence_snapshot"},
        "schema_version": {"const": 1},
        "source_query_sidecar_sha256s": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true}
      },
      "required": ["games", "grain", "schema_version", "source_query_sidecar_sha256s"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grain": {"const": "effective_dated_venue_team_reference"},
        "observed_venue_date_mappings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observedMapping"}},
        "schema_version": {"const": 1},
        "team_payload_sha256s": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}},
        "teams": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/team"}},
        "timezone_rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/timezone"}},
        "venue_payload_sha256s": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}},
        "venues": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/venue"}}
      },
      "required": ["grain", "observed_venue_date_mappings", "schema_version", "team_payload_sha256s", "teams", "timezone_rows", "venue_payload_sha256s", "venues"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "games": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/historyGame"}, "uniqueItems": true},
        "grain": {"const": "verified_game_projection"},
        "schema_version": {"const": 1},
        "source_game_sha256s": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
        "source_snapshot_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["games", "grain", "schema_version", "source_game_sha256s", "source_snapshot_sha256"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "grain": {"const": "pitch"},
        "parent_coverage": {"type": "object", "additionalProperties": false, "properties": {"inclusive_start": {"$ref": "#/$defs/date"}, "inclusive_end": {"$ref": "#/$defs/date"}}, "required": ["inclusive_start", "inclusive_end"]},
        "children": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "properties": {"inclusive_start": {"$ref": "#/$defs/date"}, "inclusive_end": {"$ref": "#/$defs/date"}, "query_sidecar_sha256": {"$ref": "#/$defs/sha256"}, "split_disposition": {"const": "READY"}}, "required": ["inclusive_start", "inclusive_end", "query_sidecar_sha256", "split_disposition"]}},
        "child_query_sidecar_sha256s": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
        "played_game_pks": {"type": "array", "items": {"$ref": "#/$defs/positiveId"}, "uniqueItems": true},
        "statcast_game_pks": {"type": "array", "items": {"$ref": "#/$defs/positiveId"}, "uniqueItems": true},
        "unique_pitch_count": {"type": "integer", "minimum": 0},
        "split_state": {"const": "READY_COMPLETE"}
      },
      "required": ["schema_version", "grain", "parent_coverage", "children", "child_query_sidecar_sha256s", "played_game_pks", "statcast_game_pks", "unique_pitch_count", "split_state"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "grain": {"const": "season_d1_league_pitching_reference"},
        "records": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "properties": {"as_of_date": {"$ref": "#/$defs/date"}, "consumer_cutoff_dates": {"type": "object", "additionalProperties": {"$ref": "#/$defs/date"}}, "consuming_game_pks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/positiveId"}, "uniqueItems": true}, "earned_runs": {"type": "integer", "minimum": 0}, "outs": {"type": "integer", "minimum": 0}, "batters_faced": {"type": "integer", "minimum": 0}, "disposition": {"const": "PRESEASON_NO_CURRENT_SEASON_PITCHING"}, "query_sidecar_sha256": {"$ref": "#/$defs/sha256"}}, "required": ["as_of_date", "consumer_cutoff_dates", "consuming_game_pks", "query_sidecar_sha256"], "oneOf": [{"required": ["earned_runs", "outs", "batters_faced"]}, {"required": ["disposition"]}]}},
        "query_sidecar_sha256s": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true}
      },
      "required": ["schema_version", "grain", "records", "query_sidecar_sha256s"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "grain": {"const": "player_career_batters_faced_reference"},
        "records": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "properties": {"pitcher_id": {"$ref": "#/$defs/positiveId"}, "game_pk": {"$ref": "#/$defs/positiveId"}, "consumer_cutoff_date": {"$ref": "#/$defs/date"}, "baseline_inclusive_end_date": {"$ref": "#/$defs/date"}, "baseline_batters_faced": {"type": "integer", "minimum": 0}, "verified_statcast_bf": {"type": "integer", "minimum": 0}, "total_batters_faced": {"type": "integer", "minimum": 0}, "baseline_query_sidecar_sha256": {"$ref": "#/$defs/sha256"}, "statcast_ready_leaf_sidecar_sha256s": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}}, "statcast_split_receipt_sha256s": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}}}, "required": ["pitcher_id", "game_pk", "consumer_cutoff_date", "baseline_inclusive_end_date", "baseline_batters_faced", "verified_statcast_bf", "total_batters_faced", "baseline_query_sidecar_sha256", "statcast_ready_leaf_sidecar_sha256s", "statcast_split_receipt_sha256s"]}}
      },
      "required": ["schema_version", "grain", "records"]
    }
  ]
}
