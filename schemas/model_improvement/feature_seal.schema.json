{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "feature_set_id", "fold_id", "run_spec_sha256", "source_gate_sha256", "population_sha256", "rows_sha256", "parent_feature_seal_sha256", "evidence_sha256"],
  "properties": {
    "schema": {"const": "MODEL_IMPROVEMENT_FEATURE_SEAL_V1"},
    "feature_set_id": {"enum": ["common", "lane_c"]},
    "fold_id": {"enum": ["H22", "H23", "H24"]},
    "run_spec_sha256": {"$ref": "#/$defs/sha256"},
    "source_gate_sha256": {"$ref": "#/$defs/sha256"},
    "population_sha256": {"$ref": "#/$defs/sha256"},
    "rows_sha256": {"$ref": "#/$defs/sha256"},
    "parent_feature_seal_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "evidence_sha256": {"type": "array", "items": {"$ref": "#/$defs/sha256"}}
  },
  "allOf": [
    {
      "if": {"properties": {"feature_set_id": {"const": "common"}}},
      "then": {
        "properties": {
          "parent_feature_seal_sha256": {"type": "null"},
          "evidence_sha256": {"type": "array", "maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"feature_set_id": {"const": "lane_c"}}},
      "then": {
        "properties": {
          "parent_feature_seal_sha256": {"$ref": "#/$defs/sha256"},
          "evidence_sha256": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    }
  ],
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
