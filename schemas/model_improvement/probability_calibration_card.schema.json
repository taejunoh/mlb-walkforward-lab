{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "probability_calibration_card.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "model_id", "lane_id", "fold_id", "candidate_id", "calibration_key", "target_year", "training_start", "training_end", "run_spec_sha256", "source_gate_sha256", "prediction_contract_sha256", "weight_authority_path", "weight_authority_sha256", "calibration_rows_path", "calibration_rows_sha256", "calibration_population_sha256", "game_evidence_inventory_path", "game_evidence_inventory_sha256", "fit_spec", "alpha", "beta"],
  "properties": {
    "schema": {"const": "MODEL_IMPROVEMENT_PROBABILITY_CALIBRATION_CARD_V1"},
    "model_id": {"enum": ["v5.1", "A", "A+B", "A+B+C"]},
    "lane_id": {"enum": ["baseline", "A", "B", "C"]},
    "fold_id": {"enum": ["O19", "O20", "O21", "O22", "H22", "O23", "H23"]},
    "candidate_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "calibration_key": {"enum": ["C19", "C20", "C21", "C22O", "C22H", "C23O", "C23H"]},
    "target_year": {"type": "integer"},
    "training_start": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "training_end": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "run_spec_sha256": {"$ref": "#/$defs/digest"},
    "source_gate_sha256": {"$ref": "#/$defs/digest"},
    "prediction_contract_sha256": {"$ref": "#/$defs/digest"},
    "weight_authority_path": {"$ref": "#/$defs/absolute_path"},
    "weight_authority_sha256": {"$ref": "#/$defs/digest"},
    "calibration_rows_path": {"$ref": "#/$defs/absolute_path"},
    "calibration_rows_sha256": {"$ref": "#/$defs/digest"},
    "calibration_population_sha256": {"$ref": "#/$defs/digest"},
    "game_evidence_inventory_path": {"$ref": "#/$defs/absolute_path"},
    "game_evidence_inventory_sha256": {"$ref": "#/$defs/digest"},
    "fit_spec": {"$ref": "#/$defs/fit_spec"},
    "alpha": {"type": "number"},
    "beta": {"type": "number", "exclusiveMinimum": 0}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "absolute_path": {"type": "string", "pattern": "^/.*$"},
    "fit_spec": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "algorithm", "edge_divisor", "iterations", "l2", "tolerance", "min_rows", "required_classes"],
      "properties": {
        "schema": {"const": "MODEL_IMPROVEMENT_PROBABILITY_CALIBRATION_FIT_SPEC_V1"},
        "algorithm": {"const": "fit_logistic_v1"}, "edge_divisor": {"const": 10.0},
        "iterations": {"const": 100}, "l2": {"const": 0.000001},
        "tolerance": {"const": 0.0000000001}, "min_rows": {"const": 2},
        "required_classes": {"const": [0, 1]}
      }
    }
  }
}
