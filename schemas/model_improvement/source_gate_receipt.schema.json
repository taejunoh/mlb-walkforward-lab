{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_spec_sha256", "source_run_spec_sha256", "acquisition_contract_sha256", "checkpoint_sha256", "inventory_sha256", "validation_receipts_sha256", "snapshot_replay_sha256", "required_years", "status"],
  "properties": {
    "run_spec_sha256": {"$ref": "#/$defs/sha256"},
    "source_run_spec_sha256": {"$ref": "#/$defs/sha256"},
    "acquisition_contract_sha256": {"$ref": "#/$defs/sha256"},
    "checkpoint_sha256": {"$ref": "#/$defs/sha256"},
    "inventory_sha256": {"$ref": "#/$defs/sha256"},
    "validation_receipts_sha256": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}},
    "snapshot_replay_sha256": {"$ref": "#/$defs/sha256"},
    "required_years": {"const": [2018, 2019, 2020, 2021, 2022, 2023, 2024]},
    "status": {"const": "SOURCES_READY"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
