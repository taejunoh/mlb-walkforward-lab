{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ledger_id", "fold_id", "model_id", "run_spec_sha256", "source_gate_sha256", "source_inventory_sha256", "game_evidence_inventory_relative_path", "game_evidence_inventory_sha256", "feature_seal_sha256", "baseline_replay_sha256", "prediction_seal_sha256", "prediction_rows_sha256", "prediction_contract_sha256", "scoring_model_card_sha256", "population_sha256", "outcomes_sha256"],
  "properties": {
    "schema": {"const": "MODEL_IMPROVEMENT_OUTCOME_RECEIPT_V1"},
    "ledger_id": {"type": "string", "pattern": "^baseline/v5\\.1/(O19|O20|O21|O22|O23|H22|H23)$"},
    "fold_id": {"enum": ["O19", "O20", "O21", "O22", "O23", "H22", "H23"]},
    "model_id": {"const": "v5.1"},
    "run_spec_sha256": {"$ref": "#/$defs/sha256"},
    "source_gate_sha256": {"$ref": "#/$defs/sha256"},
    "source_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "game_evidence_inventory_relative_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/).+$"},
    "game_evidence_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "feature_seal_sha256": {"$ref": "#/$defs/sha256"},
    "baseline_replay_sha256": {"$ref": "#/$defs/sha256"},
    "prediction_seal_sha256": {"$ref": "#/$defs/sha256"},
    "prediction_rows_sha256": {"$ref": "#/$defs/sha256"},
    "prediction_contract_sha256": {"$ref": "#/$defs/sha256"},
    "scoring_model_card_sha256": {"$ref": "#/$defs/sha256"},
    "population_sha256": {"$ref": "#/$defs/sha256"},
    "outcomes_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
