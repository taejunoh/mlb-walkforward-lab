{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "parallel_model_result_run_spec.schema.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "run_id",
        "code_revision",
        "source_authority",
        "cutoffs",
        "exclusions",
        "folds",
        "baseline",
        "metrics",
        "prediction_contract",
        "prediction_contract_sha256",
        "probability_calibration_policy",
        "lane_b",
        "lane_c",
        "outputs",
        "h24_firewall"
    ],
    "properties": {
        "schema_version": {
            "enum": [
                "SYNTHETIC_TEST_ONLY",
                "PARALLEL_MODEL_RESULT_RUN_SPEC_V1"
            ]
        },
        "run_id": {
            "type": "string",
            "minLength": 1
        },
        "code_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
        },
        "source_authority": {
            "$ref": "#/$defs/source_authority"
        },
        "cutoffs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "history",
                "snapshot"
            ],
            "properties": {
                "history": {
                    "const": "D-1"
                },
                "snapshot": {
                    "const": "T-45"
                }
            }
        },
        "exclusions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "excluded_years",
                "forbidden_outcome_years",
                "forbid_h24_outcomes"
            ],
            "properties": {
                "excluded_years": {
                    "const": [
                        2025
                    ]
                },
                "forbidden_outcome_years": {
                    "const": [
                        2025
                    ]
                },
                "forbid_h24_outcomes": {
                    "const": true
                }
            }
        },
        "folds": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "H22",
                "H23",
                "H24"
            ],
            "properties": {
                "H22": {
                    "$ref": "#/$defs/h22_fold"
                },
                "H23": {
                    "$ref": "#/$defs/h23_fold"
                },
                "H24": {
                    "$ref": "#/$defs/h24_fold"
                }
            }
        },
        "baseline": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "card"
            ],
            "properties": {
                "card": {
                    "$ref": "#/$defs/baseline_card"
                }
            }
        },
        "metrics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "all_game",
                "daily"
            ],
            "properties": {
                "all_game": {
                    "const": [
                        "brier",
                        "log_loss"
                    ]
                },
                "daily": {
                    "const": [
                        "top1_date_paired"
                    ]
                }
            }
        },
        "prediction_contract": {
            "$ref": "#/$defs/prediction_contract"
        },
        "prediction_contract_sha256": {
            "$ref": "#/$defs/digest"
        },
        "probability_calibration_policy": {
            "$ref": "#/$defs/probability_calibration_policy"
        },
        "lane_b": {
            "$ref": "#/$defs/lane_b"
        },
        "lane_c": {
            "$ref": "#/$defs/lane_c"
        },
        "outputs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "root",
                "namespaces"
            ],
            "properties": {
                "root": {
                    "$ref": "#/$defs/normal_output_root"
                },
                "namespaces": {
                    "const": [
                        "source_gate",
                        "features",
                        "baseline",
                        "calibration",
                        "oof",
                        "lane_a",
                        "lane_b",
                        "lane_c",
                        "registry",
                        "h24_predictions",
                        "h24_reports"
                    ]
                }
            }
        },
        "h24_firewall": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "forbid_outcomes_before_registry",
                "forbidden_outcome_years",
                "prediction_only_year"
            ],
            "properties": {
                "forbid_outcomes_before_registry": {
                    "const": true
                },
                "forbidden_outcome_years": {
                    "const": [
                        2025
                    ]
                },
                "prediction_only_year": {
                    "const": 2024
                }
            }
        }
    },
    "$defs": {
        "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "absolute_digest": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
                "path": {"type": "string", "pattern": "^/(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"},
                "sha256": {"$ref": "#/$defs/digest"}
            }
        },
        "normal_relative": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
        },
        "normal_output_root": {
            "type": "string",
            "minLength": 1,
            "anyOf": [
                {
                    "pattern": "^/(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
                },
                {
                    "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
                }
            ]
        },
        "path_digest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "path",
                "sha256"
            ],
            "properties": {
                "path": {
                    "$ref": "#/$defs/normal_relative"
                },
                "sha256": {
                    "$ref": "#/$defs/digest"
                }
            }
        },
        "source_authority": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "authority_root",
                "source_run_spec",
                "acquisition_contract",
                "terminal_checkpoint",
                "inventory",
                "validation_receipts"
            ],
            "properties": {
                "authority_root": {
                    "$ref": "#/$defs/normal_relative"
                },
                "source_run_spec": {
                    "$ref": "#/$defs/path_digest"
                },
                "acquisition_contract": {
                    "$ref": "#/$defs/path_digest"
                },
                "terminal_checkpoint": {
                    "$ref": "#/$defs/path_digest"
                },
                "inventory": {
                    "$ref": "#/$defs/path_digest"
                },
                "validation_receipts": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/path_digest"
                    }
                }
            }
        },
        "fold": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "target_year",
                "normalization_years",
                "oof_calibration_years",
                "prediction_only"
            ],
            "properties": {
                "target_year": {
                    "type": "integer"
                },
                "normalization_years": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "oof_calibration_years": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "prediction_only": {
                    "type": "boolean"
                }
            }
        },
        "weights": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "starter",
                "offense",
                "bullpen",
                "environment",
                "defense",
                "schedule"
            ],
            "properties": {
                "starter": {
                    "type": "integer",
                    "minimum": 0
                },
                "offense": {
                    "type": "integer",
                    "minimum": 0
                },
                "bullpen": {
                    "type": "integer",
                    "minimum": 0
                },
                "environment": {
                    "type": "integer",
                    "minimum": 0
                },
                "defense": {
                    "type": "integer",
                    "minimum": 0
                },
                "schedule": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "baseline_weights": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "starter",
                "offense",
                "bullpen",
                "environment",
                "defense",
                "schedule"
            ],
            "properties": {
                "starter": {
                    "const": 35
                },
                "offense": {
                    "const": 25
                },
                "bullpen": {
                    "const": 20
                },
                "environment": {
                    "const": 10
                },
                "defense": {
                    "const": 5
                },
                "schedule": {
                    "const": 5
                }
            }
        },
        "baseline_card": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "path",
                "sha256",
                "component_weights_pp"
            ],
            "properties": {
                "path": {
                    "$ref": "#/$defs/normal_relative"
                },
                "sha256": {
                    "$ref": "#/$defs/digest"
                },
                "component_weights_pp": {
                    "$ref": "#/$defs/baseline_weights"
                }
            }
        },
        "prediction_contract": {
            "type": "object",
            "additionalProperties": false,
        "required": [
          "component_order",
          "edge_formula",
          "completeness_formula",
          "confidence_formula",
          "confidence_range",
          "component_weights_binding",
                "clip",
                "pick",
                "ranking"
            ],
            "properties": {
                "component_order": {
                    "const": [
                        "starter",
                        "offense",
                        "bullpen",
                        "environment",
                        "defense",
                        "schedule"
                    ]
                },
                "edge_formula": {
                    "const": "sum(component_weights_pp[c]/100 * (home_score[c]-away_score[c]) for c in component_order)"
                },
          "completeness_formula": {
            "const": "sum(component_weights_pp[c]/100 * min(home_quality[c],away_quality[c]) for c in component_order)"
          },
          "confidence_formula": {
            "const": "scoring.confidence_score(completeness, starter_quality, offense_quality, bullpen_quality, component_agreement(starter_edge,offense_edge,bullpen_edge,picked_side), environment_quality, schedule_quality)"
          },
          "confidence_range": {
            "const": [
              0.0,
              10.0
            ]
          },
                "component_weights_binding": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "keys",
                        "value_type",
                        "sum",
                        "source"
                    ],
                    "properties": {
                        "keys": {
                            "const": [
                                "starter",
                                "offense",
                                "bullpen",
                                "environment",
                                "defense",
                                "schedule"
                            ]
                        },
                        "value_type": {
                            "const": "integer_nonnegative_pp"
                        },
                        "sum": {
                            "const": 100
                        },
                        "source": {
                            "const": "closed_union:RunSpec.baseline.card.component_weights_pp|ScoringModelCard.parameters.component_weights_pp"
                        }
                    }
                },
                "clip": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "min",
                        "max"
                    ],
                    "properties": {
                        "min": {
                            "const": 0.1
                        },
                        "max": {
                            "const": 0.9
                        }
                    }
                },
                "pick": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "home_if",
                        "away_if",
                        "none_if"
                    ],
                    "properties": {
                        "home_if": {
                            "const": "p_home > 0.5"
                        },
                        "away_if": {
                            "const": "p_home < 0.5"
                        },
                        "none_if": {
                            "const": "p_home == 0.5"
                        }
                    }
                },
                "ranking": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "tie_order"
                    ],
                    "properties": {
                        "tie_order": {
                            "const": [
                                "pick_probability:desc",
                                "confidence:desc",
                                "starter_edge_abs:desc",
                                "scheduled_start_utc:asc",
                                "game_pk:asc"
                            ]
                        }
                    }
                }
            }
        },
        "lane_b": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "base_weights_pp",
                "fixed_weights_pp",
                "grid",
                "multipliers",
                "candidate_count",
                "keep_h22_count",
                "h22_order",
                "h23_eligibility",
                "h23_order"
            ],
            "properties": {
                "base_weights_pp": {
                    "$ref": "#/$defs/baseline_weights"
                },
                "fixed_weights_pp": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "environment",
                        "defense"
                    ],
                    "properties": {
                        "environment": {
                            "const": 10
                        },
                        "defense": {
                            "const": 5
                        }
                    }
                },
                "grid": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "starter",
                        "offense",
                        "bullpen",
                        "schedule"
                    ],
                    "properties": {
                        "starter": {
                            "const": [
                                25,
                                30,
                                35,
                                40,
                                45
                            ]
                        },
                        "offense": {
                            "const": [
                                15,
                                20,
                                25,
                                30,
                                35
                            ]
                        },
                        "bullpen": {
                            "const": [
                                10,
                                15,
                                20,
                                25,
                                30
                            ]
                        },
                        "schedule": {
                            "const": [
                                0,
                                5,
                                10,
                                15
                            ]
                        }
                    }
                },
                "multipliers": {
                    "type": "array",
                    "prefixItems": [
                        {
                            "type": "number",
                            "const": 0.75
                        },
                        {
                            "type": "number",
                            "const": 1.0
                        },
                        {
                            "type": "number",
                            "const": 1.25
                        }
                    ],
                    "items": false
                },
                "candidate_count": {
                    "const": 210
                },
                "keep_h22_count": {
                    "const": 12
                },
                "h22_order": {
                    "const": [
                        "brier",
                        "log_loss",
                        "daily_top1_delta_desc",
                        "candidate_id"
                    ]
                },
                "h23_eligibility": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "brier_no_worse_than",
                        "log_loss_no_worse_than",
                        "daily_top1_delta_vs_v51"
                    ],
                    "properties": {
                        "brier_no_worse_than": {
                            "const": "A"
                        },
                        "log_loss_no_worse_than": {
                            "const": "A"
                        },
                        "daily_top1_delta_vs_v51": {
                            "const": "positive"
                        }
                    }
                },
                "h23_order": {
                    "const": [
                        "brier",
                        "log_loss",
                        "daily_top1_delta_desc",
                        "candidate_id"
                    ]
                }
            }
        },
        "lane_c": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "parent_model_id",
                "slots",
                "coverage"
            ],
            "properties": {
                "parent_model_id": {
                    "const": "A+B"
                },
                "slots": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "environment",
                        "defense"
                    ],
                    "properties": {
                        "environment": {
                            "const": [
                                "park",
                                "weather_roof"
                            ]
                        },
                        "defense": {
                            "const": [
                                "oaa",
                                "framing",
                                "blocking_throwing"
                            ]
                        }
                    }
                },
                "coverage": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "H22",
                        "H23",
                        "H24"
                    ],
                    "properties": {
                        "H22": {
                            "const": "admitted_or_neutral_100pct"
                        },
                        "H23": {
                            "const": "admitted_or_neutral_100pct"
                        },
                        "H24": {
                            "const": "prediction_only_admitted_or_neutral_100pct"
                        }
                    }
                }
            }
        },
        "h22_fold": {
            "allOf": [
                {
                    "$ref": "#/$defs/fold"
                },
                {
                    "properties": {
                        "target_year": {
                            "const": 2022
                        },
                        "normalization_years": {
                            "const": [
                                2018,
                                2019,
                                2020,
                                2021
                            ]
                        },
                        "oof_calibration_years": {
                            "const": [
                                2019,
                                2020,
                                2021
                            ]
                        },
                        "prediction_only": {
                            "const": false
                        }
                    }
                }
            ]
        },
        "h23_fold": {
            "allOf": [
                {
                    "$ref": "#/$defs/fold"
                },
                {
                    "properties": {
                        "target_year": {
                            "const": 2023
                        },
                        "normalization_years": {
                            "const": [
                                2019,
                                2020,
                                2021,
                                2022
                            ]
                        },
                        "oof_calibration_years": {
                            "const": [
                                2019,
                                2020,
                                2021,
                                2022
                            ]
                        },
                        "prediction_only": {
                            "const": false
                        }
                    }
                }
            ]
        },
        "h24_fold": {
            "allOf": [
                {
                    "$ref": "#/$defs/fold"
                },
                {
                    "properties": {
                        "target_year": {
                            "const": 2024
                        },
                        "normalization_years": {
                            "const": [
                                2020,
                                2021,
                                2022,
                                2023
                            ]
                        },
                        "oof_calibration_years": {
                            "const": [
                                2019,
                                2020,
                                2021,
                                2022,
                                2023
                            ]
                        },
                        "prediction_only": {
                            "const": true
                        }
                    }
                }
            ]
        },
        "probability_calibration_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema", "fold_keys", "fit_spec", "pools", "calibration_feature_receipts", "baseline_rows_relative_template", "baseline_card_relative_template"],
            "properties": {
                "schema": {"const": "MODEL_IMPROVEMENT_PROBABILITY_CALIBRATION_POLICY_V1"},
                "fold_keys": {"const": {"O19": "C19", "O20": "C20", "O21": "C21", "O22": "C22O", "H22": "C22H", "O23": "C23O", "H23": "C23H"}},
                "fit_spec": {"type": "object", "additionalProperties": false, "required": ["schema", "algorithm", "edge_divisor", "iterations", "l2", "tolerance", "min_rows", "required_classes"], "properties": {"schema": {"const": "MODEL_IMPROVEMENT_PROBABILITY_CALIBRATION_FIT_SPEC_V1"}, "algorithm": {"const": "fit_logistic_v1"}, "edge_divisor": {"const": 10.0}, "iterations": {"const": 100}, "l2": {"const": 0.000001}, "tolerance": {"const": 0.0000000001}, "min_rows": {"const": 2}, "required_classes": {"const": [0, 1]}}},
                "pools": {"const": {"C19": {"target_year": 2019, "training_start": "2018-01-01", "training_end": "2018-12-31"}, "C20": {"target_year": 2020, "training_start": "2018-01-01", "training_end": "2019-12-31"}, "C21": {"target_year": 2021, "training_start": "2018-01-01", "training_end": "2020-12-31"}, "C22O": {"target_year": 2022, "training_start": "2018-01-01", "training_end": "2021-12-31"}, "C22H": {"target_year": 2022, "training_start": "2018-01-01", "training_end": "2021-12-31"}, "C23O": {"target_year": 2023, "training_start": "2018-01-01", "training_end": "2022-12-31"}, "C23H": {"target_year": 2023, "training_start": "2018-01-01", "training_end": "2022-12-31"}}},
                "calibration_feature_receipts": {"type": "object", "additionalProperties": false, "required": ["C19", "C20", "C21", "C22O", "C22H", "C23O", "C23H"], "properties": {"C19": {"$ref": "#/$defs/absolute_digest"}, "C20": {"$ref": "#/$defs/absolute_digest"}, "C21": {"$ref": "#/$defs/absolute_digest"}, "C22O": {"$ref": "#/$defs/absolute_digest"}, "C22H": {"$ref": "#/$defs/absolute_digest"}, "C23O": {"$ref": "#/$defs/absolute_digest"}, "C23H": {"$ref": "#/$defs/absolute_digest"}}},
                "baseline_rows_relative_template": {"const": "baseline/v5.1/{fold_id}/v2/calibration_rows.jsonl"},
                "baseline_card_relative_template": {"const": "baseline/v5.1/{fold_id}/v2/probability_calibration_card.json"}
            }
        }
    }
}
