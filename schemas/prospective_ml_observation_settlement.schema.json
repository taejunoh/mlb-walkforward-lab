{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"},
    "relative": {"type": "string", "minLength": 1},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["game_pk", "official_date", "away_team", "home_team", "status", "winner"],
      "properties": {
        "game_pk": {"type": "integer", "minimum": 1},
        "official_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "away_team": {"type": "string", "minLength": 1},
        "home_team": {"type": "string", "minLength": 1},
        "status": {"anyOf": [{"enum": ["FINAL", "PENDING", "POSTPONED", "SUSPENDED", "TIE", "NO_CONTEST"]}, {"type": "string", "pattern": "^(POSTPON|SUSPEND|CANCEL)"}]},
        "winner": {"type": ["string", "null"], "minLength": 1}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "content_sha256", "snapshot_relative", "snapshot_sha256", "revision", "prior_record_relative", "prior_record_sha256", "result", "result_receipt_relative", "result_receipt_sha256", "result_manifest_relative", "result_manifest_sha256", "result_payload_relative", "result_payload_sha256", "result_observed_at_utc", "result_durable_at_utc"],
  "properties": {
    "schema": {"const": "PROSPECTIVE_ML_SETTLEMENT_V1"},
    "content_sha256": {"$ref": "#/$defs/sha256"},
    "snapshot_relative": {"$ref": "#/$defs/relative"},
    "snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "revision": {"type": "integer", "minimum": 1},
    "prior_record_relative": {"anyOf": [{"$ref": "#/$defs/relative"}, {"type": "null"}]},
    "prior_record_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "result": {"$ref": "#/$defs/result"},
    "result_receipt_relative": {"$ref": "#/$defs/relative"},
    "result_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "result_manifest_relative": {"$ref": "#/$defs/relative"},
    "result_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "result_payload_relative": {"$ref": "#/$defs/relative"},
    "result_payload_sha256": {"$ref": "#/$defs/sha256"},
    "result_observed_at_utc": {"$ref": "#/$defs/utc"},
    "result_durable_at_utc": {"$ref": "#/$defs/utc"}
  }
}
