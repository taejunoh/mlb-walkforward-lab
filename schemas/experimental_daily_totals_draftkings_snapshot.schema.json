{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experimental_daily_totals_draftkings_snapshot.schema.json",
  "title": "Provisional DraftKings daily totals snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "content_sha256", "target_date", "model_trace_relative", "model_trace_sha256", "model_report_relative", "model_report_sha256", "comparison_bound_at_utc", "source_name", "book_id", "source_url", "capture_method", "captured_at_utc", "raw_capture_relative", "raw_capture_sha256", "raw_capture_byte_length", "games"],
  "properties": {
    "schema": {"const": "PROVISIONAL_DAILY_TOTALS_DK_SNAPSHOT_V1"},
    "content_sha256": {"$ref": "#/$defs/sha"},
    "target_date": {"const": "2026-09-01"},
    "model_trace_relative": {"$ref": "#/$defs/path"},
    "model_trace_sha256": {"$ref": "#/$defs/sha"},
    "model_report_relative": {"$ref": "#/$defs/path"},
    "model_report_sha256": {"$ref": "#/$defs/sha"},
    "comparison_bound_at_utc": {"$ref": "#/$defs/timestamp"},
    "source_name": {"const": "DraftKings"},
    "book_id": {"const": "DRAFTKINGS"},
    "source_url": {"type": "string", "pattern": "^https://sportsbook\\.draftkings\\.com(?:[/?][^#]*)?$"},
    "capture_method": {"const": "EXTERNAL_MANUAL"},
    "captured_at_utc": {"$ref": "#/$defs/timestamp"},
    "raw_capture_relative": {"$ref": "#/$defs/path"},
    "raw_capture_sha256": {"$ref": "#/$defs/sha"},
    "raw_capture_byte_length": {"type": "integer", "minimum": 1},
    "games": {"type": "array", "minItems": 15, "maxItems": 15, "items": {"oneOf": [{"$ref": "#/$defs/quotedGame"}, {"$ref": "#/$defs/noQuoteGame"}]}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.?\\.?(/|$))[^\\\\]+$"},
    "timestamp": {"type": "string", "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,6})?Z$"},
    "gamePk": {"enum": [822929, 823340, 824391, 824472, 822687, 824716, 823661, 824070, 824633, 822854, 824148, 824313, 823984, 825038, 823908]},
    "price": {"anyOf": [{"type": "integer", "minimum": 100, "maximum": 10000}, {"type": "integer", "minimum": -10000, "maximum": -100}]},
    "quotedGame": {
      "type": "object", "additionalProperties": false,
      "required": ["game_pk", "status", "draftkings_event_id", "event_label", "line_half_runs", "over_american_odds", "under_american_odds"],
      "properties": {
        "game_pk": {"$ref": "#/$defs/gamePk"}, "status": {"const": "QUOTED"},
        "draftkings_event_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "event_label": {"type": "string", "minLength": 1, "maxLength": 512},
        "line_half_runs": {"type": "integer", "minimum": 1},
        "over_american_odds": {"$ref": "#/$defs/price"}, "under_american_odds": {"$ref": "#/$defs/price"}
      }
    },
    "noQuoteGame": {
      "type": "object", "additionalProperties": false,
      "required": ["game_pk", "status", "reason"],
      "properties": {"game_pk": {"$ref": "#/$defs/gamePk"}, "status": {"const": "NO_QUOTE"}, "reason": {"enum": ["NOT_LISTED", "UNAVAILABLE"]}}
    }
  }
}
