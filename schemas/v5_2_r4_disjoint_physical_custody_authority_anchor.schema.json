      "properties": {
        "volume_uuid": {"$ref": "#/$defs/uuid"}, "device": {"type": "integer", "minimum": 1}, "inode": {"type": "integer", "minimum": 1}, "ctime_ns": {"type": "integer", "minimum": 0}, "file_type": {"const": "regular"}, "mode": {"type": "integer", "minimum": 0}, "uid": {"type": "integer", "minimum": 0}, "nlink": {"const": 1}, "byte_size": {"type": "integer", "minimum": 1}
