        "contract": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "protocols/v5_2_qd/historical_source_acquisition_recovery_schedule_conflicts_missing_venue_r4_disjoint_v2.json"}, "sha256": {"$ref": "#/$defs/sha256"}}},
        "run_spec": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "protocols/v5_2_qd/historical_walkforward_500_recovery_schedule_conflicts_missing_venue_r4.json"}, "sha256": {"$ref": "#/$defs/sha256"}}},
        "journal": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "audit/v5_2_qd/historical_recovery_schedule_conflicts_missing_venue_r4/acquisition/custody_issuance_journal_r4_disjoint_v2.ndjson"}, "sha256": {"$ref": "#/$defs/sha256"}}}
      }
