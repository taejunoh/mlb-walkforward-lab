    "amendmentBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "git_blob_id"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "git_blob_id": {"$ref": "#/$defs/sha1"}}
