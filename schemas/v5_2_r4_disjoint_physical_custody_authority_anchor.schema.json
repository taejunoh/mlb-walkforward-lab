    "supersession": {
      "type": "object", "additionalProperties": false,
      "required": ["old_custody_parent", "old_final_root", "old_owner_lock", "observer_state", "metadata_inconsistent", "final_root_identity", "owner_lock_identity", "observed_leaf_count", "observed_directory_count", "observed_content_closure_sha256"],
      "properties": {
        "old_custody_parent": {"const": "/Users/taejunoh/Documents/MLB Custody"}, "old_final_root": {"const": "/Users/taejunoh/Documents/MLB Custody/v5_1_bt_r4"}, "old_owner_lock": {"const": "/Users/taejunoh/Documents/MLB Custody/.v5_1_bt_r4.issuance.lock"}, "observer_state": {"const": "OBSERVER_INCOMPLETE_LOCKED"}, "metadata_inconsistent": {"const": true}, "final_root_identity": {"$ref": "#/$defs/directoryIdentity"}, "owner_lock_identity": {"$ref": "#/$defs/regularIdentity"}, "observed_leaf_count": {"type": "integer", "minimum": 0}, "observed_directory_count": {"type": "integer", "minimum": 0}, "observed_content_closure_sha256": {"$ref": "#/$defs/sha256"}
      }
