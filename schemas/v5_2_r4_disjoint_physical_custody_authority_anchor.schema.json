    "amendment": {
      "type": "object", "additionalProperties": false,
      "required": ["design", "implementation_plan", "implementation"],
      "properties": {"design": {"$ref": "#/$defs/amendmentBinding"}, "implementation_plan": {"$ref": "#/$defs/amendmentBinding"}, "implementation": {"$ref": "#/$defs/amendmentBinding"}}
