      "required": ["executable_sha256", "executable_identity", "repository_head", "repository_tree", "repository_clean", "implementation_blob", "design_blob", "plan_blob", "source_approval_sha256", "target_volume_uuid", "supersedes_incomplete_attempt_sha256"],
      "properties": {
        "executable_sha256": {"$ref": "#/$defs/sha256"}, "executable_identity": {"$ref": "#/$defs/executableIdentity"}, "repository_head": {"$ref": "#/$defs/sha1"}, "repository_tree": {"$ref": "#/$defs/sha1"}, "repository_clean": {"const": true}, "implementation_blob": {"$ref": "#/$defs/sha1"}, "design_blob": {"$ref": "#/$defs/sha1"}, "plan_blob": {"$ref": "#/$defs/sha1"}, "source_approval_sha256": {"const": "2ec8bf0237cc5bdb00ddb6d2236ac631bb793aed9ba79f308672a9ecb90809c6"}, "target_volume_uuid": {"$ref": "#/$defs/uuid"}, "supersedes_incomplete_attempt_sha256": {"$ref": "#/$defs/sha256"}
      }
