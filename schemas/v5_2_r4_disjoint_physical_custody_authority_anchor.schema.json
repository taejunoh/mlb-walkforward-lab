    "directoryIdentity": {"type": "object", "additionalProperties": false, "required": ["file_type", "volume_uuid", "device", "inode", "ctime_ns", "mode", "flags"], "properties": {"file_type": {"const": "directory"}, "volume_uuid": {"$ref": "#/$defs/uuid"}, "device": {"type": "integer", "minimum": 1}, "inode": {"type": "integer", "minimum": 1}, "ctime_ns": {"type": "integer", "minimum": 0}, "mode": {"type": "integer", "minimum": 0}, "flags": {"type": "integer", "minimum": 0}}},
    "regularIdentity": {"type": "object", "additionalProperties": false, "required": ["file_type", "volume_uuid", "device", "inode", "ctime_ns", "mode", "flags", "size"], "properties": {"file_type": {"const": "regular"}, "volume_uuid": {"$ref": "#/$defs/uuid"}, "device": {"type": "integer", "minimum": 1}, "inode": {"type": "integer", "minimum": 1}, "ctime_ns": {"type": "integer", "minimum": 0}, "mode": {"type": "integer", "minimum": 0}, "flags": {"type": "integer", "minimum": 0}, "size": {"type": "integer", "minimum": 0}}},
